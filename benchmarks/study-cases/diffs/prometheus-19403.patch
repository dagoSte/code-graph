@@ -1233 +1256 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
-		return e
+		return de
@@ -1236 +1259 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
-			e.Val *= -1
+			de.Val *= -1
@@ -1238 +1261 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
-		if durationLiteralOutOfRange(e.Val) {
+		if durationLiteralOutOfRange(de.Val) {
@@ -1242,2 +1265,2 @@ func (p *parser) applyUnaryOpToDurationExpr(op Item, expr Node, wrapped bool) No
-		e.PosRange.Start = op.Pos
-		return e
+		de.PosRange.Start = op.Pos
+		return de
diff --git a/promql/parser/prettier.go b/promql/parser/prettier.go
index 4b9ee17c1..980293cee 100644
--- a/promql/parser/prettier.go
+++ b/promql/parser/prettier.go
@@ -85,2 +85,7 @@ func (e *DurationExpr) Pretty(int) string {
-		// This is a unary duration expression.
-		s = fmt.Sprintf("%s%s", e.Op, e.RHS.Pretty(0))
+		// Unary plus is not printed, matching String(), so a parenthesised
+		// number lifted into a unary-plus DurationExpr round-trips as (5).
+		if e.Op == ADD && e.RHS != nil {
+			s = e.RHS.Pretty(0)
+		} else {
+			s = fmt.Sprintf("%s%s", e.Op, e.RHS.Pretty(0))
+		}
