+
+def test_simplify_univariate_endpoints():
+    assert simplify(~((x > 2) & (x < 5))) == (x <= 2) | (x >= 5)
+    assert simplify(~((x >= 2) & (x <= 5))) == (x < 2) | (x > 5)
+    assert simplify(~((x >= 2) & (x < 5))) == (x < 2) | (x >= 5)
+    assert simplify(~((x > 2) & (x <= 5))) == (x <= 2) | (x > 5)
+    expr = ~((x > 2) & (x < 4)) & ~((x > 5) & (x < 7))
+    res = simplify(expr)
+    for v in range(9):
+        assert res.subs(x, v) == expr.subs(x, v)
